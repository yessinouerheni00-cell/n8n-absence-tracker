      "id": "94dfa137-d0dc-42dd-9f46-fc42f637f015",
      "name": "Get row(s) in sheet"
    },
    {
      "parameters": {
        "jsCode": "\nconst rows = $input.all();\nconst request = $(\"Code in JavaScript\").first().json;\nconst requestedSubject = (request.subject || \"\").toLowerCase();\n\nconst totals = {};\nlet all = 0;\n\nfor (const row of rows) {\n  const subject = (row.json.subject || \"\").toLowerCase();\n  const hours = Number.parseFloat(row.json.hours) || 0;\n\n  totals[subject] = (totals[subject] || 0) + hours;\n  all += hours;\n}\n\nlet msg;\n\nif (requestedSubject) {\n  msg = `📊 ${requestedSubject}: ${totals[requestedSubject] || 0}h`;\n} else {\n  msg = \"📊 Absences:\\n\";\n\n  for (const subject in totals) {\n    msg += `- ${subject}: ${totals[subject]}h\\n`;\n  }\n\n  msg += `Total: ${all}h`;\n}\n\nreturn [{ json: { msg } }];\n"
      },
      "type": "n8n-nodes-base.code",
